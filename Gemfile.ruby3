source 'https://rubygems.org'

gem 'rack', '~> 1.0'

if RUBY_VERSION < '2.7'
  gem 'aws-eventstream', '< 1.3'
end

# bigdecimal 1.3.5 is incompatible with Ruby 3.0+ (removed rb_check_safe_obj)
if RUBY_VERSION < '3.0'
  gem 'activesupport', '~> 4.0'
  gem 'bigdecimal', '~> 1.3.5'
end

group :test do
  gem 'webmock'
end

# Specify your gem's dependencies in aptible-cli.gemspec
gemspec

gem "did_you_mean", "~> 2.0"
